# Copia este archivo a .env.local para desarrollo local.
# En producción (Vercel), estas mismas variables se configuran en
# Project Settings → Environment Variables (o se generan automáticamente
# al agregar el storage, en el caso de DATABASE_URL).

# Postgres — requerido. Gratis con Neon:
# Vercel Dashboard → tu proyecto → Storage → Create Database → Postgres (Neon).
# Al crearla, Vercel agrega esta variable automáticamente. Usa la connection
# string "pooled" (host con sufijo -pooler), no la "direct" — serverless abre
# muchas conexiones cortas y el plan gratis de Neon tiene un límite bajo de
# conexiones directas simultáneas.
DATABASE_URL=postgres://usuario:password@host-pooler.neon.tech/basededatos?sslmode=require

# NVIDIA NIM — opcional. Sin esto, la app funciona igual, solo sin
# moderación automática de reportes/acopios ni explicación de riesgo en
# lenguaje simple. Gratis en https://build.nvidia.com (crear cuenta, generar
# API key).
NVIDIA_API_KEY=
# Opcional, por si el modelo por defecto deja de estar disponible gratis:
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct
